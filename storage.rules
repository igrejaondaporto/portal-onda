rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() { return request.auth != null; }
    function minhaBase(b)  { return autenticado() && request.auth.token.baseId == b; }
    // "auxiliar" (Louvor, Kinder) tem as mesmas funções do líder — o
    // mesmo que souLiderBase no firestore.rules; as Cloud Functions
    // nunca deixam esse papel entrar no token de outra base.
    function lider(b)      { return minhaBase(b)
                                 && (request.auth.token.papel == 'lider_base' || request.auth.token.papel == 'auxiliar'); }
    function imagem()      { return request.resource.contentType.matches('image/.*')
                                 && request.resource.size < 6 * 1024 * 1024; }
    // espelha vejoTodosReembolsos() do firestore.rules — só o
    // Financeiro (bases/financeiro.veReembolsos == "todas") sobe o
    // comprovativo de pagamento, numa base que não é a dele.
    function vejoTodosReembolsos() { return autenticado() && request.auth.token.ve_todos_reembolsos == true; }

    match /bases/{base}/pessoas/{pessoa} {
      allow read:  if minhaBase(base);
      allow write: if (request.auth.uid == pessoa || lider(base)) && imagem();
    }
    // Comprovativo de capacitação (Base Kinder) — o documento que a
    // pessoa sobe para provar que entregou (o certificado de registo
    // criminal, uma foto do certificado do curso…). Mais sensível do
    // que a foto de perfil ao lado — nunca minhaBase(base) sozinho,
    // só a própria pessoa e a líder.
    match /bases/{base}/pessoas/{pessoa}/capacitacoes/{ficheiro} {
      allow read:  if request.auth.uid == pessoa || lider(base);
      allow write: if (request.auth.uid == pessoa || lider(base))
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Foto da criança e de cada responsável/autorizado (Base Kinder) —
    // sempre processada por guardarFotoPessoa (registarFamiliaKinder/
    // editarFamiliaKinder, Admin SDK) nunca escrita direta: os pais
    // não têm sessão nenhuma para passar por aqui (registo/link são
    // sem conta), a foto viaja em base64 dentro da própria função. O
    // link devolvido já leva o token de leitura — a app nunca precisa
    // de ler este caminho a sério; fica só como documentação/defesa.
    match /bases/kinder/criancas/{ficheiro} {
      allow read:  if minhaBase('kinder');
      allow write: if false;
    }
    match /bases/kinder/familias/{familia}/pessoas/{ficheiro} {
      allow read:  if minhaBase('kinder');
      allow write: if false;
    }
    match /bases/{base}/funcoes/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if lider(base) && imagem();
    }
    // Equipamentos da Técnica: a foto do item e a FATURA DE COMPRA
    // (`{itemId}-fatura`), que é o documento a apresentar se for
    // preciso acionar a garantia — e essa chega quase sempre em PDF,
    // não em fotografia. Mesmo limite dos reembolsos, que já aceitam
    // as duas coisas pela mesma razão. Continua só o líder a escrever.
    match /bases/{base}/inventario/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if lider(base)
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Biblioteca (Base Louvor): capa processada pela Cloud Function
    // processarCapaMusica (Admin SDK, ignora estas regras) — o cliente
    // só lê, nunca escreve aqui diretamente.
    match /bases/{base}/capas/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if false;
    }
    match /bases/{base}/wiki/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if minhaBase(base) && imagem();  // qualquer voluntário sobe foto de passo
    }
    match /bases/{base}/melhorias/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if minhaBase(base) && imagem();  // qualquer voluntário reporta com foto
    }
    match /bases/{base}/reembolsos/{ficheiro} {
      allow read:  if minhaBase(base) || vejoTodosReembolsos();
      // minhaBase(base) sobe a fatura (quem pede); vejoTodosReembolsos()
      // sobe o comprovativo de pagamento (o Financeiro, noutra base) —
      // a mesma pasta serve as duas coisas, distinguidas pelo sufixo do
      // nome do ficheiro (ver criarReembolso/marcarReembolsosPagos).
      allow write: if (minhaBase(base) || vejoTodosReembolsos())
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Lição — Base New: só o líder sobe, sempre .docx. Base Kinder: o
    // documento da lição em si, geralmente um PDF (às vezes foto de
    // página impressa, ou .docx) — ver lib/licoes.js de cada app.
    // Na Kinder qualquer pessoa da base pode subir o FICHEIRO aqui —
    // quem pode mesmo PUBLICAR a lição (líder, ou a Mestra da sala
    // nesse culto) é decidido a sério por guardarLicaoKinder
    // (functions/kinder.js), que confirma contra a Escala; as rules
    // não têm como olhar para isso ficheiro a ficheiro. Um upload sem
    // publicação fica só um ficheiro solto, sem efeito nenhum na app.
    match /bases/{base}/licoes/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if (lider(base) || (base == 'kinder' && minhaBase(base)))
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                       || request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }
    // Brand (Comunicação): foto de fundo do card de cada marca. Raiz,
    // não bases/comunicacao — a coleção marcas também é raiz (leitura
    // para todas as bases, ver firestore.rules). Único upload de
    // Brand/Acervo — os recursos dentro do kit e o Acervo continuam
    // só por link (ver CLAUDE.md desta base, decisão explícita do
    // líder de reverter a regra "sem upload" só para este campo).
    match /marcas/{ficheiro} {
      allow read:  if autenticado();
      allow write: if lider('comunicacao') && imagem();
    }
    // Mural Onda: fotos de cada anúncio, uma pasta por autor — só
    // quem publicou sobe/substitui as suas (uid no caminho, como
    // bases/{base}/pessoas/{pessoa} acima). Leitura pública de
    // propósito: os anúncios em si já são visíveis a qualquer pessoa
    // autenticada (ver firestore.rules), e uma foto de sofá não tem
    // nada de sensível a esconder de quem tem o link direto.
    match /anuncios/{autor}/{anuncio}/{ficheiro} {
      allow read:  if true;
      allow write: if request.auth.uid == autor && imagem();
    }
    match /eventos/{evento}/ordem.pdf {
      allow read:  if autenticado();
      // no delete, request.resource é sempre null — só se exige o
      // contentType quando há mesmo um ficheiro a entrar (create/update).
      // pode_publicar_culto vem do token (ver claimsExtraDaBase em
      // functions/index.js, a partir de bases/{b}.culto.pode_publicar) —
      // antes disto, qualquer líder de qualquer base publicava a ordem
      // do culto da igreja toda, sem gate nenhum.
      allow write: if autenticado()
                   && request.auth.token.papel == 'lider_base'
                   && request.auth.token.pode_publicar_culto == true
                   && (request.resource == null || request.resource.contentType == 'application/pdf');
    }
    match /{tudo=**} { allow read, write: if false; }
  }
}
