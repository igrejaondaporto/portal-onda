rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() { return request.auth != null; }
    function minhaBase(b)  { return autenticado() && request.auth.token.baseId == b; }
    function lider(b)      { return minhaBase(b) && request.auth.token.papel == 'lider_base'; }
    function imagem()      { return request.resource.contentType.matches('image/.*')
                                 && request.resource.size < 6 * 1024 * 1024; }

    match /bases/{base}/pessoas/{pessoa} {
      allow read:  if minhaBase(base);
      allow write: if (request.auth.uid == pessoa || lider(base)) && imagem();
    }
    match /bases/{base}/funcoes/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if lider(base) && imagem();
    }
    // Equipamentos da Técnica: a foto do item e a FATURA DE COMPRA
    // (`{itemId}-fatura`), que é o documento a apresentar se for
    // preciso acionar a garantia — e essa chega quase sempre em PDF,
    // não em fotografia. Mesmo limite dos reembolsos, que já aceitam
    // as duas coisas pela mesma razão. Continua só o líder a escrever.
    match /bases/{base}/inventario/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if lider(base)
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Biblioteca (Base Louvor): capa processada pela Cloud Function
    // processarCapaMusica (Admin SDK, ignora estas regras) — o cliente
    // só lê, nunca escreve aqui diretamente.
    match /bases/{base}/capas/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if false;
    }
    match /bases/{base}/wiki/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if minhaBase(base) && imagem();  // qualquer voluntário sobe foto de passo
    }
    match /bases/{base}/melhorias/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if minhaBase(base) && imagem();  // qualquer voluntário reporta com foto
    }
    match /bases/{base}/reembolsos/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if minhaBase(base)
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    // Lição (Base New): só o líder sobe, sempre .docx — ver
    // lib/licoes.js e a regra irmã em firestore.rules.
    match /bases/{base}/licoes/{ficheiro} {
      allow read:  if minhaBase(base);
      allow write: if lider(base)
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }
    // Brand (Comunicação): foto de fundo do card de cada marca. Raiz,
    // não bases/comunicacao — a coleção marcas também é raiz (leitura
    // para todas as bases, ver firestore.rules). Único upload de
    // Brand/Acervo — os recursos dentro do kit e o Acervo continuam
    // só por link (ver CLAUDE.md desta base, decisão explícita do
    // líder de reverter a regra "sem upload" só para este campo).
    match /marcas/{ficheiro} {
      allow read:  if autenticado();
      allow write: if lider('comunicacao') && imagem();
    }
    match /eventos/{evento}/ordem.pdf {
      allow read:  if autenticado();
      // no delete, request.resource é sempre null — só se exige o
      // contentType quando há mesmo um ficheiro a entrar (create/update).
      // pode_publicar_culto vem do token (ver claimsExtraDaBase em
      // functions/index.js, a partir de bases/{b}.culto.pode_publicar) —
      // antes disto, qualquer líder de qualquer base publicava a ordem
      // do culto da igreja toda, sem gate nenhum.
      allow write: if autenticado()
                   && request.auth.token.papel == 'lider_base'
                   && request.auth.token.pode_publicar_culto == true
                   && (request.resource == null || request.resource.contentType == 'application/pdf');
    }
    match /{tudo=**} { allow read, write: if false; }
  }
}
