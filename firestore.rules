rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  REGRA DE OURO
//  O hash do PIN NUNCA vive no documento da pessoa. Vive em
//  pessoas/{p}/privado/auth (global — um só PIN por pessoa, em
//  qualquer base em que sirva), que nenhum cliente lê.
//  As Cloud Functions usam o Admin SDK e ignoram estas regras.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado()      { return request.auth != null; }
    function minhaBase(b)       { return autenticado() && request.auth.token.baseId == b; }
    // "auxiliar" só existe na Louvor e na Kinder (tem as mesmas funções
    // do líder da base, pedido de cada líder, 2026-09) — seguro tratar
    // aqui de forma genérica: as Cloud Functions recusam esse papel para
    // qualquer outra base (BASES_COM_AUXILIAR em functions/index.js),
    // então nunca chega a entrar no token de mais ninguém.
    function souLiderBase(b) {
      return minhaBase(b)
        && (request.auth.token.papel == 'lider_base' || request.auth.token.papel == 'auxiliar');
    }
    function euSou(p)           { return autenticado() && request.auth.uid == p; }
    // capacidade de base (Backstage e o que vier a seguir) — carregada
    // no token por entrar/trocarBase a partir de bases/{b}.veEscalas,
    // nunca lida do Firestore aqui (ver CLAUDE.md raiz, regra 4)
    function vejoTodasEscalas() { return autenticado() && request.auth.token.ve_todas_escalas == true; }
    // idem para o Financeiro: bases/{b}.veReembolsos == "todas" (ver
    // claimsExtraDaBase). Lê os reembolsos de qualquer base; quem paga
    // é a Cloud Function, esta claim só abre a LEITURA.
    function vejoTodosReembolsos() { return autenticado() && request.auth.token.ve_todos_reembolsos == true; }
    // idem para o Painel Pastoral: bases/{b}.visaoPastoral == true (ver
    // claimsExtraDaBase). Abre só DUAS leituras aqui — o funil de
    // visitantes e o arquivo de cada culto —, que são listas a sério e
    // perderiam o tempo real se passassem por uma função. Tudo o resto
    // que o painel vê das outras bases (inventário, melhorias, wiki,
    // pessoas) vem do Admin SDK em functions/pastoral.js, de propósito:
    // eram ~15 blocos a ganhar uma condição nova cada um, neste
    // ficheiro que faz deploy sozinho ao entrar na main.
    function vejoTudoPastoral() { return autenticado() && request.auth.token.ve_tudo_pastoral == true; }

    // ── identidade global — só nome/foto/quais bases, para o login
    // único e o seletor de base. O que é específico de cada base
    // (papel, ativo, telefone, cor…) continua em bases/{b}/pessoas. ──
    match /pessoas/{pessoa} {
      allow read: if euSou(pessoa);
      allow write: if false;                        // só por função
      match /privado/{doc} { allow read, write: if false; }
      // ── exceção única ao `privado` fechado acima: onde a pessoa quer
      // receber os reembolsos (MB Way ou IBAN). Vive aqui, e não no
      // perfil da base, porque é global como o PIN — quem serve em
      // duas bases recebe na mesma conta — e porque NENHUM líder de
      // base tem de ver o IBAN de ninguém. Só a dona lê e escreve; o
      // Financeiro nunca lê daqui, lê a cópia que o próprio pedido de
      // reembolso carrega (ver reembolsos/{r}.pagamento).
      // O `privado/auth` (hash do PIN) continua fechado: a regra
      // genérica acima nega tudo, esta só abre este documento.
      match /privado/pagamento {
        allow read:  if euSou(pessoa);
        allow write: if euSou(pessoa)
                     && request.resource.data.metodo in ['mbway', 'transferencia']
                     && request.resource.data.destino is string
                     && request.resource.data.destino.size() > 0;
      }
    }

    // ── ponteiro do culto ao vivo — qual eventoId está a gravar agora,
    // seja qual for a data. Todas as bases leem, para saber onde ligar
    // o ponto rosa; só a Cloud Function escreve (ver
    // iniciarCultoAoVivo/descartarCultoAoVivo/sondarFreeshow).
    match /config/cultoAoVivo {
      allow read:  if autenticado();
      allow write: if false;
    }

    // ── índice leve de busca da Wiki (Base Técnica) — recalculado
    // pela Cloud Function a cada publicação, nunca escrito pelo cliente
    match /wikiIndice/{base} {
      allow read: if minhaBase(base);
      allow write: if false;                        // só por função
    }

    match /bases/{base} {
      // o documento em si é só nome/horas/cor — nada sensível — para o
      // seletor de base conseguir mostrar o nome de uma base que não é
      // a ativa no token, e para quem "vê todas as escalas" mostrar o
      // nome/cor de cada base na tela "Todas as bases". As subcoleções
      // abaixo continuam fechadas à base do token (minhaBase), isto
      // não abre nada por baixo — é só nome/cor/horário.
      allow read:  if autenticado();
      allow write: if false;                       // só por função

      // ── pessoas ──────────────────────────────────────────
      match /pessoas/{pessoa} {
        // toda a base se vê (é a grelha de login e as escalas)
        allow read: if minhaBase(base);
        // cada um edita o seu perfil, menos o papel. `aniversario`
        // (só a Louvor usa, "MM-DD" sem ano — CLAUDE.md dessa base)
        // entra na mesma lista partilhada por todas as bases; as
        // outras nunca mandam esse campo, não têm UI para isso.
        allow update: if euSou(pessoa)
                      && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['nome','foto','telefone','aniversario','atualizadoEm']);
        allow create, delete: if false;            // só por função
        // o segredo
        match /privado/{doc} { allow read, write: if false; }
        // capacitações feitas (Base Kinder) — incluindo a data e a
        // validade do certificado de registo criminal. Cada um marca
        // as suas; a líder vê (e corrige) as de todos. Mais ninguém lê.
        match /capacitacoes/{cap} {
          allow read:  if minhaBase(base) && (euSou(pessoa) || souLiderBase(base));
          allow write: if minhaBase(base) && (euSou(pessoa) || souLiderBase(base));
        }
      }

      // ── catálogo de funções ──────────────────────────────
      match /funcoes/{funcao} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }

      // ── catálogo de GDs (Base Pessoal) — lista fixa que a líder
      // mantém, sugerida no Formulário de contacto. Mesmo padrão do
      // catálogo de funções: só a líder escreve, a base toda lê. ──
      match /gds/{gd} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }

      // ── avisos (Base Louvor): mensagens do líder para a equipa,
      // mostradas no Início. Escrita direta do cliente, sem Cloud
      // Function — mesmo padrão de funcoes/gds acima (só o líder
      // escreve, sem autoria mista, sem campo que precise de ser
      // calculado no servidor). "Excluir" é só ativo:false (regra 5
      // do CLAUDE.md raiz — nada se apaga a sério), o mesmo vale para
      // os modelos reutilizáveis. ──
      match /avisos/{aviso} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }
      match /avisosModelos/{modelo} {
        allow read, write: if souLiderBase(base);
      }

      // ── modelos de ordem do culto (Painel Pastoral) ──
      // O domingo típico, guardado para não ser remontado de raiz toda
      // a semana. Mesmo padrão dos avisosModelos acima: é um rascunho
      // reutilizável de quem manda na base, sem autoria mista e sem
      // nada a calcular no servidor — escrita direta chega. O que SAI
      // daqui para a igreja (a ordem publicada) continua a passar pela
      // publicarOrdemCulto, como sempre. Genérico por `base`, como
      // tudo neste ficheiro: não é uma regra "da pastoral".
      match /modelosOrdem/{modelo} {
        allow read, write: if souLiderBase(base);
      }

      // ── lições (Base New): o líder sobe um .docx, fica visível
      // para toda a base. Mesmo padrão de avisos/funcoes acima — só
      // o líder escreve, sem autoria mista, sem delete a sério
      // (excluir tira o documento inteiro de propósito aqui, ao
      // contrário de avisos: é um ficheiro no Storage, não um estado
      // "ativo:false" que faça sentido manter). O ficheiro em si tem
      // a regra dele em storage.rules. ──
      match /licoes/{licao} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }

      // ── adolescentes + presença na Lição (Base New): os jovens não
      // são voluntários, não têm login nem PIN — é só um catálogo de
      // nomes que qualquer voluntário mantém, para marcar quem esteve
      // em cada domingo. Sem autoria mista real (não há "dono" de um
      // adolescente), por isso escrita aberta a toda a base, como
      // funcoes/avisos mas sem o gate de líder — quem passa a lição
      // naquele domingo é quem marca. ──
      match /adolescentes/{pessoa} {
        allow read, write: if minhaBase(base);
      }
      match /presencasLicao/{evento} {
        allow read, write: if minhaBase(base);
      }

      // ── config (Base Técnica): tabela de correspondência de nomes
      // FreeShow → painel para a ordem do culto ao vivo. Só a própria
      // base lê (é o único ecrã que a usa), só por Cloud Function. ──
      match /config/{doc} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
      }

      // ── ministérios (Base Técnica, Comunicação) ───────────
      // Comunicação também lê para quem NÃO é da Comunicação: quem
      // abre uma solicitação (SheetAbrirSolicitacao, qualquer base)
      // escolhe o ministério certo (Fotografia/Social Media/...) —
      // mesma lógica do carve-out de marcas/acervo (nome/cor não é
      // sensível). As outras bases continuam fechadas a minhaBase. ──
      match /ministerios/{ministerio} {
        allow read:  if minhaBase(base) || (base == 'comunicacao' && autenticado());
        allow write: if souLiderBase(base);
      }

      // ── wiki (Técnica, Comunicação): autoria mista (líder cria
      // esqueletos, qualquer voluntário escreve/edita/responde) e
      // cada write tem de recalcular wikiIndice/{base} — por isso
      // passa sempre pela Cloud Function, nunca escrita direta. ──
      match /wiki/{artigo} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
        match /respostas/{resposta} {
          allow read:  if minhaBase(base);
          allow write: if false;                   // só por função
        }
      }

      // ── melhorias (Base Técnica): autoria mista, como a wiki —
      // qualquer voluntário reporta/comenta/resolve, só o líder
      // define a meta e reabre. Sempre por Cloud Function. ──
      match /melhorias/{melhoria} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
        match /eventos/{evento} {
          allow read:  if minhaBase(base);
          allow write: if false;                   // só por função
        }
      }

      // ── equipamentos (Base Comunicação): custódia, não stock —
      // dois itens, quem está com cada um e desde quando. Passar um
      // item grava o histórico na mesma escrita (garantia que só a
      // função dá), por isso é sempre por Cloud Function. ──
      match /equipamentos/{item} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
        match /historico/{h} {
          allow read:  if minhaBase(base);
          allow write: if false;                   // só por função
        }
      }

      // ── inventário: qualquer voluntário mexe na quantidade direto.
      // Criar, editar o resto (nome, categoria, mínimo, foto…) e desativar
      // passa sempre pelas Cloud Functions — é lá que se decide se quem
      // pede é o líder da base ou o líder de escala no dia do culto dele. ──
      match /inventario/{item} {
        allow read:   if minhaBase(base);
        allow update: if minhaBase(base)
                      && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['quantidade','atualizadoEm','atualizadoPor']);
        allow create, delete: if false;
        match /movimentos/{mov} {
          allow read:   if minhaBase(base);
          allow create: if minhaBase(base) && request.resource.data.pessoaId == request.auth.uid;
          allow update, delete: if false;          // histórico é imutável
        }
      }

      // ── lista de compras: acrescentar/tirar/mexer quantidade é
      // escrita direta do cliente (rápido, sem round-trip a uma
      // função) — só o campo `itens` muda, só enquanto
      // `estado == "aberta"` (antes e depois, para não dar para
      // "reabrir" uma lista já fechada por esta via). A única exceção
      // é o primeiro item de uma lista nova, quando ainda não há
      // nenhuma "aberta" — aí passa por adicionarItemListaCompras
      // (functions/index.js), porque uma regra de update comum não
      // consegue apontar uma condição a um documento que ainda não
      // existe. Fechar/enviar continuam restritos a líder da base ou
      // responsável do culto de hoje, sempre por função. ──
      match /listasCompras/{lista} {
        allow read:   if minhaBase(base);
        allow update: if minhaBase(base)
                      && resource.data.estado == 'aberta'
                      && request.resource.data.estado == 'aberta'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens']);
        allow create, delete: if false;                // só por função
      }

      // ── enquetes de indisponibilidade: um documento por mês,
      // aberto/fechado só pelo líder. Voto privado — cada voluntário
      // só lê a própria resposta, o líder vê o conjunto. Sempre por
      // Cloud Function (abrir/fechar/responder), em QUALQUER base —
      // apagar/reabrir tem de limpar respostas antigas na mesma
      // escrita, e é o que alimenta a Escala sugerida (ver
      // CLAUDE.md da Comunicação e functions/index.js). ──
      match /enquetes/{mes} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
        match /respostas/{pessoa} {
          allow read:  if souLiderBase(base) || euSou(pessoa);
          allow write: if false;                   // só por função
        }
      }

      // ── tour de primeiro login: conteúdo dos passos, por base.
      // Muda raramente (escrito por script, não pelo líder) — lido só
      // sob demanda (getDoc pontual), nunca com onSnapshot. ──
      match /tour/{doc} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só pelo script de seed
      }

      // ── reembolsos ───────────────────────────────────────
      // submetido → aprovado|indeferido (líder) → pago|devolvido
      // (Financeiro, por Cloud Function). `devolvido` volta à mesa da
      // líder, que aprova de novo ou indefere — daí o update dela
      // continuar aberto a qualquer estado. O dono só escreve ao criar;
      // depois disso o único campo que lhe pertence é
      // vistoPeloVoluntario — para fechar o aviso de "indeferido",
      // "devolvido" ou "pago" no Início sem poder tocar em mais nada
      // (estado, comentarioLider… continuam só do líder).
      //
      // `pagamento` é uma CÓPIA do método guardado em
      // pessoas/{uid}/privado/pagamento, tirada no momento do envio, e
      // nunca mais muda: o Financeiro tem de saber para que conta pagou
      // ESTE pedido, não para onde a pessoa recebe hoje. Mesma razão
      // por que `pessoaNome` fica gravado aqui em vez de resolvido a
      // cada leitura — o painel lê 9 bases de uma vez por
      // collectionGroup e bases/{b}/pessoas é fechado a minhaBase.
      match /reembolsos/{r} {
        allow read:   if souLiderBase(base)
                      || vejoTodosReembolsos()
                      || resource.data.pessoaId == request.auth.uid;
        allow create: if minhaBase(base)
                      && request.resource.data.pessoaId == request.auth.uid
                      && request.resource.data.estado == 'submetido'
                      && request.resource.data.baseId == base
                      && request.resource.data.valor is number
                      && request.resource.data.valor > 0
                      && request.resource.data.pagamento.metodo in ['mbway', 'transferencia']
                      && request.resource.data.pagamento.destino is string
                      && request.resource.data.pagamento.destino.size() > 0
                      // mantém esta lista igual a CATEGORIAS_DESPESA em
                      // packages/shared/src/lib/categoriasDespesa.js —
                      // sem isso o Relatório do Financeiro não consegue
                      // somar "gastámos quanto em quê".
                      && request.resource.data.categoria in
                         ['limpeza', 'equipamento', 'alimentacao', 'escritorio', 'decoracao', 'transporte', 'outro']
                      // o rasto da fatura EM PAPEL (voluntário → líder →
                      // Financeiro). Nasce sempre por receber: quem
                      // confirma a entrega ao Financeiro é o líder (ao
                      // aprovar) e o próprio Financeiro (por função,
                      // marcarFaturaFisica) — nunca quem pede.
                      && request.resource.data.fatura.comLider is bool
                      && request.resource.data.fatura.recebida == false;
        // o Financeiro NÃO escreve daqui — pagar e devolver passam pela
        // Cloud Function (CLAUDE.md raiz, regra 3: o que é de alguém
        // decidir nunca é escrita direta do cliente).
        allow update: if souLiderBase(base)
                      || (resource.data.pessoaId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistoPeloVoluntario']));
        allow delete: if false;
      }

      // ── Financeiro: contagem da oferta (Base Financeiro) ──
      // Nota a nota, moeda a moeda, depois do culto. Dado só desta
      // base, sem autoria mista, por isso escrita direta do cliente
      // (mesmo padrão de funcoes/avisos) e sem Cloud Function.
      //
      // Tudo em CÊNTIMOS, inteiros — ver lib/oferta.js. Ao contrário
      // dos pagamentos já feitos (imutáveis), uma contagem PODE ser
      // corrigida por cima: contar mal acontece, e obrigar a criar
      // uma segunda contagem do mesmo culto só faria o histórico
      // mentir. Nunca se apaga (regra 5 do CLAUDE.md raiz).
      //
      // A base financeiro não tem "caixa" nenhum: entradas, despesas
      // fixas e fornecedores existiram aqui em 2026-09 e foram
      // removidos (ver CLAUDE.md da app) — esta base paga reembolsos
      // e conta a oferta, mais nada.
      match /contagensOferta/{c} {
        allow read:   if minhaBase(base);
        allow create, update: if minhaBase(base)
                      && request.resource.data.contadoPor == request.auth.uid
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.data is string;
        allow delete: if false;
      }

      // ── biblioteca de músicas (Base Louvor) — só o líder (ou
      // auxiliar, já coberto por souLiderBase) cadastra música nova
      // (2026-09, antes era qualquer voluntário); adicionar versão
      // continua aberto a todos. Só o líder marca a versão padrão da
      // Onda (decisão 3 do CLAUDE.md desta base). Nada é apagado a
      // sério, por isso não há allow delete. ──
      match /musicas/{musica} {
        allow read:   if minhaBase(base);
        allow create: if souLiderBase(base);
        allow update: if minhaBase(base)
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['versaoPadraoId'])
                          || souLiderBase(base));
        allow delete: if false;
        match /versoes/{versao} {
          allow read:          if minhaBase(base);
          allow create, update: if minhaBase(base);
          allow delete:        if false;
        }
      }

      // ── índice invertido do histórico de tons, por cantor (Base
      // Louvor) — a versão É o cantor (nome da versão = nome da
      // pessoa); um documento por pessoa com todas as versões que já
      // cantou, para "todas as músicas que este cantor já cantou" sem
      // collectionGroup query nenhuma (ver Biblioteca.jsx). Escrito
      // só pela Cloud Function registarUsoVersaoLouvor (transação,
      // evita corrida entre dois toques quase juntos) — nunca
      // desalinha com o `historico` gravado na própria versão. ──
      match /indiceCantores/{cantor} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
      }

      // ── repertório do domingo (Base Louvor) — um por culto, sem
      // rascunho: fica visível para a projeção assim que existe (a
      // Técnica lê para a tela, ver CLAUDE.md da Louvor). Escrita só
      // da própria base — a Técnica só lê. ──
      match /repertorios/{repertorio} {
        allow read:            if minhaBase(base) || minhaBase('tecnica');
        allow create, update: if minhaBase(base);
        allow delete:          if false;
      }

      // ── rascunho de escala (Base Louvor) — cobre vários domingos
      // de uma vez, escondido dos voluntários por desenho (só existe
      // "escala" de verdade quando publicado). Sempre por Cloud
      // Function: guardarRascunhoEscala/publicarRascunhoEscala/
      // excluirRascunhoEscala. ──
      match /rascunhosEscala/{rascunho} {
        allow read:  if souLiderBase(base);
        allow write: if false;                     // só por função
      }

      // ── Acomodação (Base Pessoal) — planta do auditório + arquivo ──
      // planta: configuração (fileiras, reservados, bloqueios
      // permanentes) — só a líder edita, direto do cliente, como
      // funcoes/{funcao} acima. O estado ao vivo por culto vive em
      // eventos/{evento}/acomodacao/mapa (ver bloco lá em baixo).
      match /acomodacao/planta {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }
      // resumos: escrito só pela Cloud Function fecharAcomodacao (os
      // números derivam do mapa ao vivo, não podem vir do cliente).
      // Coleção irmã de acomodacao (não subcoleção dela) — bases/{base}/
      // acomodacao/resumos/{evento} tem um nº ímpar de segmentos e não
      // é sequer um caminho de documento válido no Firestore.
      match /acomodacaoResumos/{evento} {
        allow read:  if minhaBase(base);
        allow write: if false;
      }

      // ── Base Kinder: famílias e crianças (dados de menores e de
      // saúde). Lê só quem está na própria base — nunca `autenticado()`,
      // que também é verdade para as sessões anónimas do kiosk de
      // chamadas. Escrita sempre por Cloud Function (functions/kinder.js):
      // os pais escrevem sem conta, pelo link da família. ──
      match /familias/{familia} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
      }
      match /criancas/{crianca} {
        allow read:  if minhaBase(base);
        allow write: if false;                     // só por função
      }
      // definições da base que a líder muda (Kinder: faixas etárias,
      // texto do consentimento). Diferente de config/{doc}, que é só
      // por função.
      match /definicoes/{doc} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }
      // catálogos que só a líder mantém (Kinder) — mesmo padrão de funcoes
      match /checklistSala/{item} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }
      match /capacitacoes/{cap} {
        allow read:  if minhaBase(base);
        allow write: if souLiderBase(base);
      }
      // ocorrências (Kinder: queda, febre…) — quem regista vê as suas,
      // a líder vê todas e marca "pais avisados"/resolvida. Nunca apagadas.
      match /ocorrencias/{ocorrencia} {
        allow read:   if souLiderBase(base)
                      || (minhaBase(base) && resource.data.registadoPor == request.auth.uid);
        allow create: if minhaBase(base) && request.resource.data.registadoPor == request.auth.uid;
        allow update: if souLiderBase(base);
        allow delete: if false;
      }
    }

    // ── contactos (Formulário da Base Pessoal) — coleção GLOBAL,
    // fora de bases/ e de pessoas/ de propósito: o painel do pastor
    // (ainda não existe) vai precisar de ler isto por cima de todas
    // as bases, um dia. Por agora só a Pessoal escreve e só a Pessoal
    // lê — quando o painel do pastor nascer, a leitura abre-se para
    // ele sem mexer no que já está gravado (ver apps/pessoal/CLAUDE.md).
    // Criação valida a forma exata (etapa sempre "visita" — o funil
    // das etapas seguintes é só do painel do pastor). Atualização
    // (corrigir um contacto, marcar "enviado ao pastor", "excluir" —
    // sempre arquivado:true, nunca um delete a sério) fica aberta a
    // quem está na base, mesmo nível de quem cria — só os campos
    // automáticos/de identidade (eventoId, etapa, criadoPor, rgpd,
    // baseOrigemId, criadoEm) é que ficam de fora, nunca se tocam
    // depois de criado. Nunca apagado a sério.
    match /contactos/{contacto} {
      // "quando o painel do pastor nascer, a leitura abre-se para ele
      // sem mexer no que já está gravado" — é esta linha, e nada mais
      // mudou aqui: a Pessoal continua a criar sempre com
      // etapa:"visita" e a poder corrigir os mesmos campos de sempre.
      // O painel NÃO escreve por esta via: mover de etapa é a Cloud
      // Function moverEtapaContacto (grava o histórico na mesma
      // escrita, coisa que uma regra não garante).
      allow read: if minhaBase('pessoal') || vejoTudoPastoral();
      allow create: if minhaBase('pessoal')
                    && request.resource.data.baseOrigemId == 'pessoal'
                    && request.resource.data.etapa == 'visita'
                    && request.resource.data.criadoPor == request.auth.uid
                    && request.resource.data.rgpd.aceite == true;
      allow update: if minhaBase('pessoal')
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nome', 'telemovel', 'telemovelDigitos', 'email', 'concelho', 'freguesia', 'gdSugerido', 'enviadoPastorEm', 'arquivado']);
      allow delete: if false;
    }

    // ── eventos: o culto é da IGREJA, não da base ──────────
    match /eventos/{evento} {
      allow read:  if autenticado();
      allow write: if false;                       // só por função

      // as duas bases passam por Cloud Function (guardarEscalaTecnica/
      // guardarEscalaApoio) — é lá que se valida o cruzamento entre
      // bases (quem serve nas duas não fica escalado nas duas no
      // mesmo culto). Já não é escrita direta do cliente em nenhuma.
      // Leitura: quem serve em cada base é a coisa sensível aqui
      // (nomes) — só a própria base lê a sua, mais quem tiver a
      // capacidade "vê todas as escalas" (hoje só a Backstage).
      match /escalas/{base} {
        allow read:  if minhaBase(base) || vejoTodasEscalas();
        allow write: if false;

        // confirmação de presença (Base Louvor, 2026-09) — cada
        // pessoa só lê a própria, o líder vê todas. Sempre por
        // confirmarPresencaLouvor (confirmar E desfazer).
        match /confirmacoes/{pessoa} {
          allow read:  if minhaBase(base) && (souLiderBase(base) || euSou(pessoa));
          allow write: if false;
        }

        // confirmação de presença no ENSAIO (Base Louvor, 2026-09) —
        // mesmo padrão de /confirmacoes acima, subcoleção própria
        // porque é uma pergunta diferente (ensaio, não culto). Sempre
        // por confirmarPresencaEnsaioLouvor.
        match /confirmacoesEnsaio/{pessoa} {
          allow read:  if minhaBase(base) && (souLiderBase(base) || euSou(pessoa));
          allow write: if false;
        }
      }

      // pessoa+culto, não de uma base — só quem serve em mais do que
      // uma base tem entrada aqui, gravada pelas mesmas funções acima
      match /indisponibilidades/{pessoa} {
        allow read:  if autenticado();
        allow write: if false;
      }

      // as atribuições passam SEMPRE pela função atribuirFuncao,
      // que confirma a data antes de gravar
      match /atribuicoes/{a} { allow read: if autenticado(); allow write: if false; }

      match /checklist/{c} {
        allow read: if autenticado();
        allow write: if autenticado()
                     && exists(/databases/$(database)/documents/eventos/$(evento)/escalas/$(request.auth.token.baseId))
                     && request.auth.uid in
                        get(/databases/$(database)/documents/eventos/$(evento)/escalas/$(request.auth.token.baseId)).data.pessoas;
      }

      // notas da Técnica sobre o repertório que a Louvor montou —
      // hoje só "temos no FreeShow?" por item (ver RepertorioCard.jsx).
      // Nota da Técnica sobre dado da Louvor, nunca o inverso — por
      // isso vive aqui, não em bases/louvor/repertorios, e só a
      // Técnica lê/escreve. Escrita direta do cliente (sem Cloud
      // Function), mesmo padrão de contagem/geral — id fixo "tecnica",
      // sem necessidade de mais nenhuma base ter isto.
      match /repertorioNotas/tecnica {
        allow read, write: if minhaBase('tecnica');
      }

      // contagem do culto da Base Pessoal — um documento vivo por culto.
      // Escreve direto do cliente para continuar utilizável quando a rede
      // falha; cada categoria regista quem a preencheu e a sua origem.
      // Não há delete: a contagem integra o histórico do culto.
      match /contagem/geral {
        allow read: if autenticado();
        allow create, update: if minhaBase('pessoal');
        allow delete: if false;
      }

      // ── Base Kinder, por culto ──
      // check-in e códigos de levantamento: só por função (código único
      // no culto, confere à saída). Lê só a Kinder.
      match /checkinKinder/{crianca} {
        allow read:  if minhaBase('kinder');
        allow write: if false;
      }
      match /codigosKinder/{familia} {
        allow read:  if minhaBase('kinder');
        allow write: if false;
      }
      // checklist de sala marcada (um doc por sala) e contagem corrigida
      // à mão — escrita direta, para funcionar sem rede ao domingo, como
      // a contagem da Pessoal. Sem delete: fazem parte do histórico.
      match /checklistKinder/{sala} {
        allow read:           if minhaBase('kinder');
        allow create, update: if minhaBase('kinder');
        allow delete:         if false;
      }
      match /contagemKinder/{doc} {
        allow read:           if minhaBase('kinder');
        allow create, update: if minhaBase('kinder');
        allow delete:         if false;
      }

      // mapa do auditório da Base Pessoal — escreve direto do cliente
      // (sem Cloud Function) de propósito: é o único jeito de marcar
      // lugares offline, e Cloud Functions não correm sem rede. Três
      // perfis podem escrever: a líder da base, quem tem a função
      // "Mapa" (id fixo "drive" — nome antigo, de quando isto vivia
      // numa folha do Google Drive; ver bases/pessoal/funcoes/drive)
      // neste culto, e o Responsável do culto (escalas/pessoal.
      // liderEscala) — pedido explícito, o Responsável manda no
      // domingo dele mesmo sem ter a função Mapa atribuída. "drive" é
      // reservado: nenhuma outra base pode ter uma função com este id
      // (a coleção atribuicoes é plana, sem namespace de base).
      match /acomodacao/mapa {
        allow read: if autenticado();
        allow write: if souLiderBase('pessoal')
                     || (minhaBase('pessoal')
                         && exists(/databases/$(database)/documents/eventos/$(evento)/atribuicoes/drive)
                         && request.auth.uid in
                            get(/databases/$(database)/documents/eventos/$(evento)/atribuicoes/drive).data.pessoas)
                     || (minhaBase('pessoal')
                         && exists(/databases/$(database)/documents/eventos/$(evento)/escalas/pessoal)
                         && get(/databases/$(database)/documents/eventos/$(evento)/escalas/pessoal).data.liderEscala
                            == request.auth.uid);
      }

      // registo ao vivo da ordem do culto (Base Técnica ↔ FreeShow) —
      // gravado pela função agendada sondarFreeshow e pelas onCall
      // iniciarCultoAoVivo/descartarCultoAoVivo/editarSecaoAoVivo.
      // Leitura para todas as bases (é sobre o culto, não só a Técnica).
      match /cultoAoVivo/{doc} {
        allow read:  if autenticado();
        allow write: if false;                     // só por função
      }

      // arquivo do culto terminado (só estatística, gravado por
      // arquivarCultoTerminado ao finalizar o culto ao vivo). Nasceu
      // fechado a toda a gente "para o futuro Painel do Pastor" — esse
      // painel existe desde 2026-09 e é o único que lê. Escrita
      // continua só Admin SDK: nem o painel escreve aqui.
      match /estatisticasCulto/{doc} {
        allow read:  if vejoTudoPastoral();
        allow write: if false;
      }
    }

    // ── solicitações à Comunicação ─────────────────────────
    // Raiz, não bases/comunicacao: é escrita por líderes de QUALQUER
    // base e lida por duas bases (quem pediu + a Comunicação). Toda a
    // escrita passa por Cloud Function (abrirSolicitacao/
    // editarSolicitacao/assumirSolicitacao/mudarStatusSolicitacao) —
    // foraDoPrazo tem de ser calculado no servidor, e cada mudança de
    // estado grava histórico na mesma escrita, coisa que as regras não
    // garantem sozinhas.
    match /solicitacoes/{id} {
      allow read:  if minhaBase(resource.data.baseSolicitanteId) || minhaBase('comunicacao');
      allow write: if false;                     // só por função
    }

    // ── recados do Painel Pastoral para uma base ───────────
    // De ida, sem resposta e sem estado (decisão do dono do produto,
    // 2026-09): o pastor escreve, o líder lê e dispensa. Não é uma
    // `solicitacao` — essa tem prazo, transferência e histórico de
    // estados, e nada disso se aplica aqui.
    //
    // Raiz, e não bases/{b}/avisos: os avisos são do líder para a
    // equipa dele, e só a Louvor tem tela para eles. Uma coleção
    // própria deixa cada base mostrar o recado com um componente
    // partilhado pequeno, sem que nenhuma das dez tenha de ganhar o
    // ecrã de avisos inteiro nem distinguir origens no mesmo sítio.
    //
    // Toda a base LÊ o que é dela (é para a equipa saber, não só o
    // líder); só o LÍDER dispensa, e dispensar é a única escrita que
    // o cliente pode fazer — dois campos e mais nada, para um líder
    // não poder reescrever o texto do recado que recebeu. Criar é só
    // por função (enviarRecadoPastoral); apagar, nunca (regra 5).
    match /recados/{id} {
      allow read:   if minhaBase(resource.data.baseId) || vejoTudoPastoral();
      allow update: if souLiderBase(resource.data.baseId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['dispensado', 'dispensadoEm']);
      allow create, delete: if false;            // só por função
    }

    // ── Brand: marcas + acervo ──────────────────────────────
    // Raiz, não bases/comunicacao: leitura para TODAS as bases (o
    // líder de Kids precisa do logo certo tanto quanto a Comunicação
    // — briefing §6.7). Escrita só do líder da Comunicação. Sem
    // autoria mista nem histórico obrigatório (ao contrário de
    // Solicitações), por isso escrita direta do cliente já chega,
    // como funcoes/{ministerio}. ──
    match /marcas/{marca} {
      allow read:  if autenticado();
      allow write: if souLiderBase('comunicacao');
      match /recursos/{recurso} {
        allow read:  if autenticado();
        allow write: if souLiderBase('comunicacao');
      }
      match /categoriasRecurso/{categoria} {
        allow read:  if autenticado();
        allow write: if souLiderBase('comunicacao');
      }
    }
    match /acervo/{item} {
      allow read:  if autenticado();
      allow write: if souLiderBase('comunicacao');
    }
    match /acervoCategorias/{categoria} {
      allow read:  if autenticado();
      allow write: if souLiderBase('comunicacao');
    }

    // ── painel de progresso das bases (painelonda.pt) ─────
    // leitura pública (é um placar para todos acompanharem);
    // escrita exige sessão (anónima, criada pelo próprio painel) —
    // o PIN 2026 é só o portão de UX, não a segurança real.
    // Produto irmão, sem relação com o resto deste ficheiro — repo
    // próprio em github.com/vitorhugow/painel-progresso-bases.
    match /progressoBases/{doc} {
      allow read:  if true;
      allow write: if autenticado();
    }

    // ── histórico de chamadas (Kinder + o "Carro" da Técnica) ──
    // Uma subcoleção por canal, por dia (um documento por chamada,
    // não um array num documento só — Firestore ordena escritas ao
    // MESMO documento, o que empilhava atraso a cada chamada seguida
    // numa ligação lenta; ver ouvirHistoricoChamadas/registarChamada
    // em packages/shared/src/lib/chamadas.js). Leitura pública (é um
    // telão, sem dado sensível — só nomes de crianças e matrículas já
    // mostradas na projeção); escrita exige sessão — PIN normal na
    // Técnica, sessão anónima no Kinder (kiosk sem login por pessoa,
    // ver apps/kinder/src/App.jsx) — mesmo padrão de progressoBases
    // acima. O documento `canais/{canal}` em si nunca é lido/escrito
    // — só existe como "pai" da subcoleção.
    match /chamadas/{dia}/canais/{canal}/itens/{item} {
      allow read:  if true;
      allow write: if autenticado();
    }

    // ── reembolsos de todas as bases de uma vez (Financeiro) ──
    // A regra de bases/{base}/reembolsos acima já deixa o Financeiro
    // ler pedido a pedido, mas uma query collectionGroup não é avaliada
    // por ela — o Firestore casa a query com um match de caminho
    // aberto, e sem este bloco `collectionGroup("reembolsos")` falha
    // com permission-denied mesmo tendo a claim. É a única forma de o
    // painel ver as 9 bases numa subscrição só, em tempo real, em vez
    // de nove queries (ou de uma função que perde o onSnapshot).
    // Leitura e mais nada: pagar e devolver são Cloud Function.
    match /{path=**}/reembolsos/{r} {
      allow read:  if vejoTodosReembolsos();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
